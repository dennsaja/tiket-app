<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="vertical" android:padding="28dp" android:focusable="true" android:focusableInTouchMode="true">
    <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_brand_mark" android:contentDescription="HelpDesk" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Selamat datang\nkembali." android:textColor="@color/text_primary" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.04" android:lineSpacingExtra="2dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Satu tempat untuk tiket, tim,\ndan pekerjaan lapangan kamu." android:textColor="@color/text_muted" android:textSize="14sp" android:lineSpacingExtra="5dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnWebLogin" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="32dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Lanjutkan lewat web" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/white" android:backgroundTint="@color/primary" app:cornerRadius="16dp" app:icon="@drawable/ic_ln_arrow_right" app:iconGravity="textEnd" app:iconSize="18dp" app:iconTint="@color/white" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Login di browser, lalu kembali otomatis ke aplikasi." android:textColor="@color/text_muted" android:textSize="11sp" android:gravity="center" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="22dp" android:gravity="center_vertical" android:orientation="horizontal">
      <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/card_border" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="atau masuk dengan akun" android:textColor="@color/text_muted" android:textSize="11sp" />
      <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/card_border" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/etEmail" android:text="Username atau email" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <EditText android:id="@+id/etEmail" style="@style/Helpdesk.Input" android:layout_marginTop="8dp" android:hint="Username atau nama@perusahaan.com" android:inputType="text" android:autofillHints="username" android:imeOptions="actionNext" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:labelFor="@id/etPassword" android:text="Kata sandi" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp">
      <EditText android:id="@+id/etPassword" style="@style/Helpdesk.Input" android:hint="Kata sandi akun kamu" android:inputType="textPassword" android:autofillHints="password" android:imeOptions="actionDone" android:paddingEnd="56dp" />
      <ImageButton android:id="@+id/ivTogglePassword" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:contentDescription="Tampilkan kata sandi" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_eye" app:tint="@color/text_muted" />
    </FrameLayout>
    <TextView android:id="@+id/tvError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:accessibilityLiveRegion="polite" android:textColor="@color/status_red" android:textSize="12sp" android:visibility="gone" />
    <ProgressBar android:id="@+id/pbLoading" style="?android:attr/progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:indeterminateTint="@color/accent" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Masuk" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/text_primary" android:backgroundTint="@color/surface" app:strokeColor="@color/card_border" app:strokeWidth="1dp" app:cornerRadius="16dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="HelpDesk  /  Your support, simplified." android:gravity="center" android:textColor="@color/text_muted" android:textSize="10sp" />
  </LinearLayout>
</ScrollView>