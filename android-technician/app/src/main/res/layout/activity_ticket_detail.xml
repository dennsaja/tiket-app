<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#09090B"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Kembali"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailTicketNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#1001"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailTicketTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Judul Tiket"
                android:textColor="#A1A1AA"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetailStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="IN PROGRESS"
            android:textColor="#2563EB"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Navigation Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabDetail"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Detail Tiket"
            android:textColor="#09090B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tabChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Chat Tim"
            android:textColor="#71717A"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tabReport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Laporan Kerja"
            android:textColor="#71717A"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Tab Indicator Line -->
    <View
        android:id="@+id/tabIndicator"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#E4E4E7" />

    <!-- Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TAB 1: DETAIL TIKET -->
        <ScrollView
            android:id="@+id/viewTabDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Ticket Info Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvInfoTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Judul Tiket Lengkap"
                            android:textColor="#09090B"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvInfoType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tipe: Perbaikan Infrastruktur"
                            android:textColor="#71717A"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="#F4F4F5" />

                        <!-- Customer Info -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INFORMASI PELAPOR / LOKASI"
                            android:textColor="#A1A1AA"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvInfoCustomerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pelapor: Bpk. Ahmad"
                            android:textColor="#18181B"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvInfoCustomerPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Telepon: 08123456789"
                            android:textColor="#18181B"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvInfoCustomerAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Alamat: Jl. Merdeka No. 45"
                            android:textColor="#18181B"
                            android:textSize="13sp" />

                        <!-- Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDetailCall"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:text="Hubungi Telepon"
                                android:textColor="#18181B"
                                android:textSize="12sp"
                                app:strokeColor="#E4E4E7"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDetailMap"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:text="Buka Navigasi"
                                android:textColor="#18181B"
                                android:textSize="12sp"
                                app:strokeColor="#E4E4E7"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Description Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DESKRIPSI KENDALA"
                            android:textColor="#A1A1AA"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvInfoDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="Deskripsi detail keluhan..."
                            android:textColor="#27272A"
                            android:textSize="13sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Update Status CTA Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickUpdateStatus"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#09090B"
                    android:text="Perbarui Status Pengerjaan"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: CHAT TIM & PESAN -->
        <LinearLayout
            android:id="@+id/viewTabChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshChat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMessages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="14dp" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- Message Type Selector & Composer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Type Selector -->
                <RadioGroup
                    android:id="@+id/rgMessageType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbPublicMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Balasan Publik"
                        android:textColor="#27272A"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rbInternalNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Catatan Tim (Internal)"
                        android:textColor="#D97706"
                        android:textSize="11sp" />
                </RadioGroup>

                <!-- Input Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etMessageContent"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/input_field_bg"
                        android:hint="Tulis pesan atau catatan..."
                        android:inputType="textMultiLine"
                        android:maxLines="3"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#09090B"
                        android:textColorHint="#A1A1AA"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendMessage"
                        android:layout_width="72dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#09090B"
                        android:text="Kirim"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- TAB 3: LAPORAN KERJA (BEFORE / AFTER PHOTO) -->
        <ScrollView
            android:id="@+id/viewTabReport"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Laporan Selesai &amp; Dokumentasi Foto"
                    android:textColor="#09090B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kirim bukti foto before/after untuk menyelesaikan tiket ini."
                    android:textColor="#71717A"
                    android:textSize="12sp" />

                <!-- Form Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ringkasan Pekerjaan *"
                            android:textColor="#18181B"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etReportSummary"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/input_field_bg"
                            android:hint="Contoh: Penyambungan kabel FO putus"
                            android:inputType="text"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#09090B"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Tindakan yang Dilakukan *"
                            android:textColor="#18181B"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etReportActionTaken"
                            android:layout_width="match_parent"
                            android:layout_height="68dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/input_field_bg"
                            android:gravity="top"
                            android:hint="Contoh: Splicing core 1 &amp; 2, pergantian protection sleeve"
                            android:inputType="textMultiLine"
                            android:padding="12dp"
                            android:textColor="#09090B"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Material yang Digunakan (Opsional)"
                            android:textColor="#18181B"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etReportMaterials"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/input_field_bg"
                            android:hint="Contoh: 1x Protection Sleeve 60mm"
                            android:inputType="text"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#09090B"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Hasil Akhir / Redaman (Opsional)"
                            android:textColor="#18181B"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etReportFinalResult"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/input_field_bg"
                            android:hint="Contoh: Redaman -19 dBm, koneksi stabil"
                            android:inputType="text"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#09090B"
                            android:textSize="13sp" />

                        <!-- Photo Section: Before Photos -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Foto Sebelum Pengerjaan (Before)"
                            android:textColor="#18181B"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickBeforePhotos"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:text="Pilih Foto Before"
                            android:textColor="#18181B"
                            android:textSize="12sp"
                            app:strokeColor="#E4E4E7"
                            app:cornerRadius="8dp" />

                        <TextView
                            android:id="@+id/tvBeforePhotosCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Belum ada foto dipilih"
                            android:textColor="#71717A"
                            android:textSize="11sp" />

                        <!-- Photo Section: After Photos -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Foto Sesudah Pengerjaan (After)"
                            android:textColor="#18181B"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickAfterPhotos"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:text="Pilih Foto After"
                            android:textColor="#18181B"
                            android:textSize="12sp"
                            app:strokeColor="#E4E4E7"
                            app:cornerRadius="8dp" />

                        <TextView
                            android:id="@+id/tvAfterPhotosCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Belum ada foto dipilih"
                            android:textColor="#71717A"
                            android:textSize="11sp" />

                        <!-- Submit Report Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitReport"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="22dp"
                            android:backgroundTint="#09090B"
                            android:text="Kirim Laporan &amp; Selesaikan Tiket"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
