<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_border_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Metadata Row: #Number, Ticket Type Badge, Lead Badge, Priority, Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTicketNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="#1001"
            android:textColor="#09090B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="PSB"
            android:textColor="#3F3F46"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLeadBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="KETUA TIM"
            android:textColor="#B45309"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPriorityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="HIGH"
            android:textColor="#EA580C"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="ASSIGNED"
            android:textColor="#0284C7"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Ticket Title -->
    <TextView
        android:id="@+id/tvTicketTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Perbaikan Kabel Fiber Optik Putus"
        android:textColor="#09090B"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Customer / Reporter Info Box (100% Web Pelapor Box Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/subtle_box_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pelapor: Bpk. Ahmad"
                android:textColor="#18181B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvCustomerPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:text="08123456789"
                android:textColor="#52525B"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCustomerAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Lokasi: Jl. Merdeka No. 45"
            android:textColor="#52525B"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 3 Direct Quick Action Buttons: Chat Tim (1-Tap!), Rute Maps, Hubungi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickChat"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.15"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Chat Tim"
            android:textAllCaps="false"
            android:textColor="#09090B"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="#F4F4F5"
            app:strokeColor="#D4D4D8"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavigateMap"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.15"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Rute Maps"
            android:textAllCaps="false"
            android:textColor="#1D4ED8"
            android:textSize="11sp"
            android:textStyle="bold"
            app:strokeColor="#BFDBFE"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallCustomer"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="0.95"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Hubungi"
            android:textAllCaps="false"
            android:textColor="#18181B"
            android:textSize="11sp"
            app:strokeColor="#E4E4E7"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Primary Progressive Workflow Button (Matches Web Workflow) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrimaryAction"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Terima Tiket"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

</LinearLayout>
