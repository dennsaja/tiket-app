<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_border_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Metadata Row: #Number, Ticket Type Badge, Lead Badge, Priority, Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTicketNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="#1001"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="PSB"
            android:textColor="#334155"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLeadBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="KETUA TIM"
            android:textColor="#B45309"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPriorityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="TINGGI"
            android:textColor="#EA580C"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="DITUGASKAN"
            android:textColor="#0284C7"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2 (FR-03 & FR-04): Distance from Technician + SLA Countdown Badge (Vector Icons, No Emoji) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:contentDescription="Jarak"
                android:src="@drawable/ic_ln_pin"
                app:tint="#0369A1" />

            <TextView
                android:id="@+id/tvDistanceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Jarak: -"
                android:textColor="#0369A1"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/badge_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/ivSlaIcon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:contentDescription="SLA"
                android:src="@drawable/ic_ln_clock"
                app:tint="#15803D" />

            <TextView
                android:id="@+id/tvSlaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="SLA Aktif"
                android:textColor="#15803D"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ticket Title -->
    <TextView
        android:id="@+id/tvTicketTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Perbaikan Kabel Fiber Optik Putus"
        android:textColor="#0F172A"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <!-- Customer / Reporter Info Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/subtle_box_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="Pelanggan"
                android:src="@drawable/ic_ln_user"
                app:tint="#475569" />

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Pelapor: Bpk. Ahmad"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCustomerPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:text="08123456789"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginTop="1dp"
                android:contentDescription="Alamat"
                android:src="@drawable/ic_ln_pin"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tvCustomerAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Lokasi: Jl. Merdeka No. 45"
                android:textColor="#475569"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4 Direct Quick Action Buttons with Clean Vector Icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickChat"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.05"
            android:layout_marginEnd="3dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Chat Tim"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="10.5sp"
            android:textStyle="bold"
            app:backgroundTint="#F8FAFC"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_ln_message"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="12dp"
            app:iconTint="#0F172A"
            app:strokeColor="#CBD5E1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavigateMap"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.05"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Rute Maps"
            android:textAllCaps="false"
            android:textColor="#0284C7"
            android:textSize="10.5sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_ln_navigation"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="12dp"
            app:iconTint="#0284C7"
            app:strokeColor="#BAE6FD" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWhatsAppCustomer"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="0.98"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="WhatsApp"
            android:textAllCaps="false"
            android:textColor="#15803D"
            android:textSize="10.5sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_ln_chat_round"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="12dp"
            app:iconTint="#15803D"
            app:strokeColor="#BBF7D0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallCustomer"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="0.9"
            android:layout_marginStart="3dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Telepon"
            android:textAllCaps="false"
            android:textColor="#334155"
            android:textSize="10.5sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_ln_phone"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="12dp"
            app:iconTint="#334155"
            app:strokeColor="#E2E8F0" />
    </LinearLayout>

    <!-- Primary Progressive Workflow Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrimaryAction"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="7dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Terima Tugas &amp; Mulai Perjalanan"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_ln_arrow_right"
        app:iconGravity="textEnd"
        app:iconPadding="6dp"
        app:iconSize="14dp"
        app:iconTint="#FFFFFF" />

</LinearLayout>
