#!/bin/sh
set -eu
gradle_project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${JAVA_HOME:-}" ]; then
  gradle_java="$JAVA_HOME/bin/java"
else
  gradle_java=java
fi
exec "$gradle_java" -Dorg.gradle.appname=gradlew -classpath "$gradle_project_dir/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
